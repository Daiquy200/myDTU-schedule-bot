# Telegram Bot Token (required)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database - Choose ONE:
# Option 1: SQLite (local development)
# SQLITE_PATH=schedule.db

# Option 2: PostgreSQL (production - Supabase, Neon, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 3: Turso (libSQL over HTTP)
# DATABASE_URL=libsql://your-db.turso.io?authToken=your_token

# Webhook URL (set after deployment)
# WEBHOOK_URL=https://your-domain.com/webhook